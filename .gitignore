# .gitignore - files Git must never commit.
# Rule of thumb: commit code, docs, SQL migrations, eval sets and .env.example.
# Never commit secrets, data, caches, generated output or personal editor files.

# --- Secrets ------------------------------------------------------------------
# API keys (GEMINI_API_KEY, QDRANT_API_KEY, DATABASE_URL, ...) live in .env.
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.crt
secrets.json
credentials*.json
service-account*.json

# --- Local data, caches and generated output -----------------------------------
# Source PDFs, page/vector caches (data/cache) and debug dumps (*.pages.md, *.chunks.md).
data/
cache/
.cache/
*.pages.md
*.chunks.md
# Eval run outputs (re-created by every run)
**/eval/results/
# Backups contain ALL data (Postgres rows + Qdrant chunks)
backups/
*.json.gz
# Local databases / dumps
*.sqlite
*.sqlite3
*.dump
# Logs
*.log
logs/

# --- Python ------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# --- IDEs and editors ----------------------------------------------------------
# VS Code / Cursor / Windsurf
.vscode/
.cursor/
.windsurf/
*.code-workspace
# JetBrains (PyCharm, IntelliJ)
.idea/
*.iml
# Others: Fleet, Zed, Sublime, Eclipse/PyDev, Visual Studio
.fleet/
.zed/
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/
.vs/
# Vim / Emacs swap and backup files
*.swp
*.swo
*~
\#*\#
.\#*

# --- AI assistant local settings -----------------------------------------------
**/.claude/settings.local.json
.aider*

# --- OS clutter ----------------------------------------------------------------
# macOS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Deploy tool folders (Railway / Vercel / Node UI later) ----------------------
.railway/
.vercel/
node_modules/
.next/
.vercel
.env*
