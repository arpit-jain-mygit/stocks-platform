# Copy this file to .env and fill in real values. Never commit .env.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vision role: model that reads scanned pages (check AI Studio for current free Flash model)
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.5-flash

# Embedding model and vector size. Chunks and questions must use the same values;
# changing either means every chunk is embedded again (the cache handles this).
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Vector database: which one to use (qdrant today; add pinecone etc. in utils/vectorstore)
VECTOR_STORE=qdrant

# Qdrant vector database (free cluster at https://cloud.qdrant.io)
QDRANT_URL=
QDRANT_API_KEY=
# Collection name - prefixed so it never clashes with other projects on the same cluster
QDRANT_CHUNKS_COLLECTION=stocks_rag_chunks

# Model that writes answers from the retrieved chunks (gemini-3.5-flash gives better answers when it is not overloaded)
ANSWER_PROVIDER=gemini
ANSWER_MODEL=gemini-3.5-flash-lite

# Key clients must send in the X-API-Key header to use the API (empty = no check).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=

# Optional per-role API keys. Leave empty to use the provider's shared key
# (e.g. GEMINI_API_KEY). Set one only if a role uses a different account/provider.
VISION_API_KEY=
ANSWER_API_KEY=
EMBED_API_KEY=

# Where companies, doc types and filing records live (postgres is the only option today).
# First run: python db/migrate.py (creates tables + starting companies / doc types).
METADATA_STORE=postgres
# Supabase: Connect -> Session pooler URI (IPv4; works on Railway). Direct connection is IPv6-only.
DATABASE_URL=

# RISKY delete APIs (POST /risky-delete/...): off unless true. Calls also need
# header X-Admin-Key = ADMIN_API_KEY (empty = always refused). Keep off in production.
ENABLE_RISKY_DELETE_APIS=false
ADMIN_API_KEY=

# Backup / restore APIs (POST /backup/create, /backup/restore): off unless true.
# Also need X-Admin-Key = ADMIN_API_KEY. A backup contains ALL data - keep it private.
ENABLE_BACKUP_APIS=false

# Embedding batches: chunks per request and pause between requests (free-tier friendly).
# Each finished batch is saved, so a quota error never loses completed work.
EMBED_BATCH_SIZE=20
EMBED_PAUSE_SECONDS=2

# Typed pages that are mostly figures (financial tables) are read by the vision
# model too, so columns stay aligned. Falls back to the text layer if the model fails.
TABLE_PAGES_TO_VISION=true

# --- AWS (Phase 1). Leave these as they are locally; set them on AWS (Terraform, Phase 2) -----
# Caches: local folder (default) or S3 bucket.
CACHE_BACKEND=local
# CACHE_BUCKET=stocks-insights-cache
# Ingestion jobs: memory (default, local) or DynamoDB table.
JOB_BACKEND=memory
# JOBS_TABLE=stocks-insights-jobs
# Uploads: empty = upload through /ingest (local); a bucket = presigned uploads (AWS).
# UPLOAD_BUCKET=stocks-insights-uploads
# Ingestion: background (default, local) or worker (ECS Fargate task, AWS).
INGEST_MODE=background
# ECS_CLUSTER=stocks-insights
# ECS_TASK_DEFINITION=stocks-insights-worker
# ECS_SUBNETS=subnet-aaa,subnet-bbb
# ECS_SECURITY_GROUPS=sg-xxx
# ECS_CONTAINER_NAME=worker
